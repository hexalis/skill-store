  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexalis/skill-store.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hexalis/skill-store/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/hexalis/skill-store/issues"
