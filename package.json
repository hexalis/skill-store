{
  "name": "skill-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Skill Store — skill store and manager for coding agents (CLI + core engine)",
  "license": "MIT",
  "author": "Hexalis",
  "contributors": [
    {
      "name": "Marlon Baltodano"
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm build:core && pnpm build:cli",
    "build:core": "pnpm --filter @hexalis/skill-store-core build",
    "build:cli": "pnpm --filter @hexalis/skill-store-cli build",
    "typecheck": "pnpm build:core && pnpm --filter @hexalis/skill-store-core typecheck && pnpm --filter @hexalis/skill-store-cli typecheck",
    "test": "pnpm build:core && node --import tsx --test packages/core/test/*.test.ts packages/cli/test/*.test.ts",
    "clean": "rm -rf packages/core/dist packages/cli/dist",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexalis/skill-store.git"
  },
  "homepage": "https://github.com/hexalis/skill-store#readme",
  "bugs": {
    "url": "https://github.com/hexalis/skill-store/issues"
  }
}
