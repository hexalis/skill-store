{
  "name": "@hexalis/skill-store-cli",
  "version": "0.1.0",
  "description": "Skill Store CLI — install, validate and activate agent skills globally and per project.",
  "type": "module",
  "license": "MIT",
  "author": "Hexalis",
  "contributors": [
    {
      "name": "Marlon Baltodano"
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "skill-store": "dist/cli.mjs",
    "hss": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
