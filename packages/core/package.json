{
  "name": "@hexalis/skill-store-core",
  "version": "0.1.0",
  "description": "Core engine for Skill Store: skill vault, linter, sync engine and registry client.",
  "type": "module",
  "license": "MIT",
  "author": "Hexalis",
  "contributors": [
    {
      "name": "Marlon Baltodano"
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "hexalis",
    "skill-store",
    "agent-skills",
    "claude-code",
    "cursor",
    "opencode",
    "skill-manager"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexalis/skill-store.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/hexalis/skill-store/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/hexalis/skill-store/issues"
  }
}
